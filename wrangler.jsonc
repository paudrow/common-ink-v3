{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "common-ink-v3",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // On for HTML embeds alone: a deploy sets EMBED_ORIGIN to this Worker's workers.dev address
  // (package.json's deploy), which then answers with the embed's frame and nothing else of the app.
  "workers_dev": true,
  "preview_urls": false,
  // CPU time one request may spend: an export part holding one multi-GB upload computes CRC-32 over every
  // byte, which can pass the 30 s default (src/core/zip.ts). Wall time waiting on R2 and D1 isn't counted.
  "limits": { "cpu_ms": 300000 },
  // The web app, built by Vite into dist. Pages are the single-page app. Every address except the built
  // files under /assets reaches the Worker first: it redirects www.commonink.app to commonink.app (assets
  // can't be matched by host, so it must see every path) and answers /sw.js, which the single-page
  // fallback would otherwise answer with the app's page. Everything else goes on to the assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // The database has a full-text table, which `wrangler d1 export` refuses. Its backup is D1 Time Travel.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "common-ink-v3",
      "database_id": "833000a5-43fb-497f-8080-a312d5fe078c",
      "migrations_dir": "migrations"
    }
  ],
  // Uploads' bytes. No object in it is public: each is read by the Worker, for someone it has checked.
  // The bucket must exist before the first deploy: `npx wrangler r2 bucket create common-ink-v3-uploads`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "common-ink-v3-uploads" }],
  // Every hour, the Worker removes the notes and uploads whose 30 days in Trash are up, and aborts a file sent in parts that
  // no part has reached for a day, its parts with it: `scheduled` in src/worker/index.ts. The bucket's own rule "abort
  // incomplete multipart uploads after 3 days" is the backstop for parts no row names (docs/adr/0013-big-files-go-in-parts-to-single-use-addresses.md).
  // A Preview has no timer, so nothing is removed from one's Trash on its own.
  "triggers": { "crons": ["17 * * * *"] },
  // Workers Logs keeps what the Worker writes (already redacted by src/core/logs.ts) but no invocation
  // logs: each of those records the request's full address, and an address can carry a share link's
  // token (/s/<token>, /api/shared/<token>) or Google's sign-in code (/auth/*?code=). Wrangler has no
  // setting that drops only the path, and `redact_query_string` alone would leave the share tokens.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/#invocation-logs
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  // How often one caller may ask, each a minute: src/worker/limits.ts says what each counts and by what.
  // MCP_CALLS counts an agent's tool calls where each lands (src/worker/mcp/mcp.ts); MCP_LIMIT counts one
  // token's requests to /mcp, before the token is checked.
  // A namespace id is any number unique in the Cloudflare account; Cloudflare makes it on deploy.
  "ratelimits": [
    { "name": "MCP_CALLS", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "SIGN_IN_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LINK_LIMIT", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
    { "name": "OAUTH_LIMIT", "namespace_id": "3003", "simple": { "limit": 30, "period": 60 } },
    { "name": "OPS_LIMIT", "namespace_id": "3004", "simple": { "limit": 300, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "3005", "simple": { "limit": 300, "period": 60 } },
    { "name": "TRANSCRIBE_LIMIT", "namespace_id": "3006", "simple": { "limit": 6, "period": 60 } }
  ],
  // Workers AI, for Whisper to transcribe recordings (src/worker/listen.ts). It always runs on Cloudflare, paid for by the
  // minute of audio, so the dev server leaves it out unless asked (`npm run dev -- --ai`), Previews and the built Worker
  // CI tests against leave it out (scripts/preview.ts, scripts/built-worker.ts), and unit tests stand in for it.
  "ai": { "binding": "AI" },
  // How the app is used, counted by the Worker as it happens (src/core/usage.ts, docs/adr/0020-usage-is-counted-on-the-server-not-in-the-browser.md):
  // what happened, in which workspace, by a person or an agent, and a hash of who. Never what a note, title, tag or email says.
  // Analytics Engine makes the dataset on the first write. The dev server, Previews and the built Worker CI tests leave it out.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "common_ink_usage" }],
  // Reads those counts back for the Usage page (src/worker/usageReport.ts), with the account's own access: no API token.
  // It always reads Cloudflare, so the dev server, Previews, the built Worker and tests leave it out.
  "analytics": { "binding": "USAGE_SQL" },
  // Which version of the Worker is answering: /health says its id, and a fault sent to Sentry names it as the release,
  // the same id `wrangler versions list` and `wrangler rollback` use (docs/runbooks/rollback.md).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Mail is kept from notes@ at in.commonink.app, the subdomain Cloudflare Email Routing receives for: the apex's
  // MX stays with Google Workspace (docs/email.md).
  // USAGE_WORKSPACE is the operator's own workspace, Audrow's: its admins, and nobody else, are offered the Usage page
  // (src/worker/usageReport.ts). It is an id, not a secret, so it is kept here, where a deploy can't drop it. The dev
  // server, Previews, the built Worker and tests set it empty, so there the Dev User stands for the operator.
  "vars": { "MAIL_ADDRESS": "notes@in.commonink.app", "USAGE_WORKSPACE": "aya0dfol2jvi" },
  // The optional settings are typed in src/worker/env.d.ts.
  "secrets": { "required": ["SESSION_SECRET"] }
  // Previews run on their own Worker, common-ink-v3-previews. scripts/preview.ts writes their settings: their own D1
  // database, the bucket Previews share (common-ink-v3-uploads-preview), and dev sign-in, which must never be set here.
}
