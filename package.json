{
  "name": "common-ink-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An agent-first markdown notes app.",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build && node --experimental-strip-types extension/build.ts",
    "extension:build": "node --experimental-strip-types extension/build.ts",
    "typecheck": "wrangler types --check && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p extension/tsconfig.json",
    "types": "wrangler types",
    "test": "vitest run && vitest run -c vitest.extension.config.ts && node --test test/zones/recurrence-zones.test.ts test/node/zip.test.ts test/node/restore-drill.test.ts test/node/scripts-load.test.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:others": "npm run build && node scripts/smoke-browsers.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/preview.ts",
    "ink": "node scripts/ink.ts",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@replit/codemirror-vim": "^6.4.0",
    "katex": "^0.19.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
