{
  "manifest_version": 3,
  "name": "Common Ink Clipper",
  "version": "0.1.0",
  "description": "Save a page, a selection, a link or an image to your Common Ink notes, as markdown your AI agent can read.",
  "key": "",
  "permissions": ["contextMenus", "identity", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Common Ink",
    "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" }
  },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "clip-page": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" },
      "description": "Clip this page to Common Ink"
    }
  }
}
